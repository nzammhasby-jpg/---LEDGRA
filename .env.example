# VITE_SUPABASE_URL: The URL of your Supabase project (from Settings > API)
VITE_SUPABASE_URL="https://your-project-id.supabase.co"

# VITE_SUPABASE_ANON_KEY: The public anon API key of your Supabase project (from Settings > API)
VITE_SUPABASE_ANON_KEY="your-anon-public-jwt-key"

# VITE_SENTRY_DSN: Sentry Public Client-side DSN (Public, safely sanitised)
VITE_SENTRY_DSN=""

# VITE_APP_VERSION: Optional application build/release version
VITE_APP_VERSION=""

# VITE_APP_ENV: Optional application environment (development, staging, production)
VITE_APP_ENV="development"

